# Safestic minimal configuration
# SECRET_MODE: file | manager
SECRET_MODE=file

# Restic repository URL (e.g., s3:s3.amazonaws.com/bucket, azure:account:container:restic)
RESTIC_REPOSITORY=

# File-based secret configuration
RESTIC_PASSWORD_FILE=config/restic_password.txt

# Secret manager backend (used only when SECRET_MODE=manager)
RESTIC_SECRET_BACKEND=aws

# AWS Secrets Manager
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_SECRET_ID=safestic/restic-password

# Azure Key Vault
AZURE_KEYVAULT_NAME=
AZURE_SECRET_NAME=

# GCP Secret Manager
GCP_PROJECT=
GCP_SECRET_NAME=
GCP_SECRET_VERSION=latest

# Backup source and filtering
INCLUDE_DIRS=/etc /home
EXCLUDE_FILE=
EXCLUDE_PATTERNS=
TAG=safestic
RESTIC_CACHE_DIR=.cache/restic

# Retention policy
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
KEEP_YEARLY=3

# Scheduling configuration
SCHEDULE_CRON=0 2 * * *
SCHEDULE_WIN_TIME=02:00
SCHEDULE_WIN_DAYS=MON,TUE,WED,THU,FRI
